# Local demo: no Firebase credentials, no billing, volatile data.
VITE_LOCAL_DEMO=true

# Production client: use false, then provide your Firebase web app config.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=board-game-kraken.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=board-game-kraken
# VITE_FIREBASE_APP_ID=1:894297269744:web:fc0a616d09cad151b4a935
# VITE_API_BASE_URL=https://dbg-kraken.vercel.app

# API server: set ONLY in Vercel server environment (never prefix with VITE_).
# FIREBASE_PROJECT_ID=board-game-kraken
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ALLOWED_ORIGINS=https://dbg-kraken.web.app,https://dbg-kraken.firebaseapp.com
# NODE_OPTIONS=--experimental-require-module
