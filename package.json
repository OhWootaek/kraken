{
  "name": "no-touch-kraken",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/local.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "cleanup": "node --import tsx scripts/cleanup.ts",
    "test:browser": "node --import tsx scripts/browser-check.ts",
    "test:firebase": "firebase emulators:exec --project demo-kraken --only firestore \"node --import tsx --test tests/firestore.integration.ts\"",
    "test:integration": "firebase emulators:exec --project demo-kraken --only auth,firestore \"node --import tsx --test tests/auth-game.integration.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "firebase-tools": "^15.35.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
